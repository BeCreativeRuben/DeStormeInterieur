# Resend (https://resend.com) — required for the contact form and inbound forwarding
# On Vercel: add to Production (and Preview if needed), then redeploy.
RESEND_API_KEY=

# Verified sender in Resend, e.g. "Aanvragen <onboarding@resend.dev>" for testing
# or "DESTORME DESIGN <info@destormedesign.be>" once your domain is verified
CONTACT_FROM_EMAIL=

# Where studio inquiries go (defaults to site email from lib/site.ts if unset)
# CONTACT_TO_EMAIL=

# Inbound email forwarding (Resend Receiving → webhook → Outlook)
# 1. Enable receiving for destormedesign.be in Resend (MX records)
# 2. Add webhook: https://destormedesign.be/api/webhooks/resend, event: email.received
# 3. Copy the webhook signing secret below
# Docs: https://resend.com/docs/dashboard/receiving/introduction
RESEND_WEBHOOK_SECRET=

# Optional overrides (defaults: info@destormedesign.be → destormedesign@outlook.com)
# INBOUND_RECEIVE_ADDRESS=info@destormedesign.be
# INBOUND_FORWARD_TO=destormedesign@outlook.com
# INBOUND_FORWARD_FROM=DESTORME DESIGN <info@destormedesign.be>

# Public site URL (logo in emails loads from {this}/brand-mark.png). On Vercel set to https://destormedesign.be
# NEXT_PUBLIC_SITE_URL=
